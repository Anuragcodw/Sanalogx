# =============================================================================
# MediVault — Enterprise Hospital Pharmacy Platform Environment Configuration
# Copy this file to .env and provide your production/staging secrets.
# NEVER commit your actual .env file with secrets to source control.
# =============================================================================

# ── Django Core Settings ─────────────────────────────────────────────────────
SECRET_KEY=your-django-production-secret-key-replace-this
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com,.onrender.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.onrender.com

# ── Database (MySQL) ─────────────────────────────────────────────────────────
# For Cloud MySQL (Aiven, AWS RDS, Azure MySQL with SSL):
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_cloud_mysql_password
DB_HOST=mysql-xxxx-your-project.c.aivencloud.com
DB_PORT=25773
DB_SSL_CA=ca.pem
# Note: On Render/Linux, DB_SSL_CA can be relative to backend/ (e.g. ca.pem) or /etc/secrets/ca.pem

# For Local MySQL Development (without SSL):
# DB_NAME=medivault
# DB_USER=root
# DB_PASSWORD=your_local_password
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_SSL_CA=

# ── Production SMTP Email Delivery (Gmail / Provider Relay) ──────────────────
# Use django.core.mail.backends.smtp.EmailBackend for live production delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Verified Sender Account (e.g., your Google Workspace or Gmail address)
EMAIL_HOST_USER=your_verified_sender@gmail.com

# For Gmail: 16-character Google App Password (requires 2-Step Verification)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your_16_character_app_password

# Official Sender Identity shown in recipient inboxes
# Format: "MediVault | Hospital Pharmacy Intelligence <your_verified_sender@gmail.com>"
DEFAULT_FROM_EMAIL=MediVault | Hospital Pharmacy Intelligence <your_verified_sender@gmail.com>
SERVER_EMAIL=your_verified_sender@gmail.com
EMAIL_TIMEOUT=15

# ── MediVault Platform Identity ──────────────────────────────────────────────
MEDIVAULT_SITE_NAME=MediVault
MEDIVAULT_BASE_URL=https://yourdomain.com
EMAIL_VERIFICATION_TIMEOUT_HOURS=24

# ── Redis & Background Worker (Celery) ───────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/1
